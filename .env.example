# =====================================================================
# PRÉTOIRE — Variables d'environnement
# =====================================================================
# Copiez ce fichier en `.env.local` (jamais commité) et renseignez les
# valeurs. En développement local, récupérez-les avec `supabase status`.
# =====================================================================

# URL de l'API Supabase.
#   - LOCAL : http://127.0.0.1:54321 (cf. `supabase status` → "API URL")
#   - PROD  : https://<ref-projet>.supabase.co (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique "anon" (exposée au navigateur, protégée par les policies RLS).
#   - LOCAL : `supabase status` → "anon key"
#   - PROD  : Dashboard → Project Settings → API → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (contourne TOUTES les RLS). NE JAMAIS exposer au client,
# ni préfixer NEXT_PUBLIC_. Utilisée uniquement côté serveur / scripts
# (création de comptes auth via scripts/seed-users.mjs, tâches d'admin).
#   - LOCAL : `supabase status` → "service_role key"
#   - PROD  : Dashboard → Project Settings → API → "service_role" (SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# Passage en PRODUCTION (Supabase cloud)
# =====================================================================
# 1. Créez un projet sur https://supabase.com
# 2. Liez le projet local :   supabase link --project-ref <ref-projet>
# 3. Poussez le schéma :       supabase db push
# 4. Générez les types :       supabase gen types typescript --linked > lib/database.types.ts
# 5. Renseignez ci-dessus les 3 valeurs depuis Project Settings → API.
# 6. Créez les comptes auth :  node scripts/seed-users.mjs   (avec les clés prod)
# 7. (Optionnel) Chargez les données de démonstration : supabase/seed.sql
# =====================================================================
